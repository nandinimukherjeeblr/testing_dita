                            <fo:block role="Sect" id="unique_28" chfox:nd-id="v5360335">
                                <fo:block-container page-break-after="avoid" color="rgb(7 , 55 , 99)" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title28"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d472e6580"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d472e6583"/><fo:inline>Configuring idle job
                                    detection</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0" id="unique_28_Connect_42_v5360937" chfox:nd-id="v5360937"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Identify all
                                        idle jobs in your cluster.</fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_28_Connect_42_v5360938" chfox:nd-id="v5360938"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" id="unique_28_Connect_42_v5360939" chfox:nd-id="v5360939"><fo:block end-indent="0" start-indent="0">Idle jobs are
                                            configured per cluster in the cluster edit page.
                                            Specific queues may be excluded in idle job calculation
                                            such as jobs submitted to an interactive queue.</fo:block></fo:block-container>
                                        <fo:block-container space-before="1em" id="unique_28_Connect_42_v5361094" chfox:nd-id="v5361094"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container background-color="rgba(0 , 120 , 160 , 0.09)" background-image="url('file:/C:/Program%20Files/Oxygen%20XML%20Editor%2028/frameworks/dita/DITA-OT/plugins/com.oxygenxml.webhelp.responsive/oxygen-webhelp/app/note.svg')" background-position-horizontal="0.5em" background-position-vertical="0.5em" background-repeat="no-repeat" border-bottom-color="rgb(0 , 120 , 160)" fox:border-after-start-radius="11px" fox:border-after-end-radius="11px" border-bottom-style="solid" border-bottom-width="1px" border-left-color="rgb(0 , 120 , 160)" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="rgb(0 , 120 , 160)" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="rgb(0 , 120 , 160)" fox:border-before-start-radius="11px" fox:border-before-end-radius="11px" border-top-style="solid" border-top-width="1px" space-after="1em" space-before="1em" role="Note" padding-bottom="0.75em" padding-left="3em" padding-right="0.5em" padding-top="0.75em" id="unique_28_Connect_42_v5361095" chfox:nd-id="v5361095"><fo:block end-indent="0" start-indent="0">
                                                <fo:block page-break-after="avoid" font-weight="700">Note:</fo:block>
                                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" id="unique_28_Connect_42_v5361096" chfox:nd-id="v5361096"><fo:block end-indent="0" start-indent="0">After
                                                  installing <fo:inline font-style="italic">StormCluster</fo:inline>, older settings for idle jobs
                                                  are no longer in effect. The configuration
                                                  settings must be updated.</fo:block></fo:block-container>
                                            </fo:block></fo:block-container>
                                        </fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block role="Sect">
                                        <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_28_Connect_42_v5360944" chfox:nd-id="v5360944">
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end" color="rgb(56 , 111 , 218)">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block id="unique_28_Connect_42_v5360945" chfox:nd-id="v5360945"><fo:inline id="unique_28_Connect_42_v5360946" chfox:nd-id="v5360946">Click
                                                  <fo:inline font-weight="700">Console</fo:inline>.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end" color="rgb(56 , 111 , 218)">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block id="unique_28_Connect_42_v5360948" chfox:nd-id="v5360948"><fo:inline id="unique_28_Connect_42_v5360949" chfox:nd-id="v5360949">Under the
                                                  Grid Management section of the <fo:inline font-style="italic">ClusterControl</fo:inline>
                                                  console menu bar, click <fo:inline font-weight="700">Clusters</fo:inline>.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end" color="rgb(56 , 111 , 218)">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block id="unique_28_Connect_42_v5360951" chfox:nd-id="v5360951"><fo:inline id="unique_28_Connect_42_v5360952" chfox:nd-id="v5360952">Click the
                                                  cluster name of the cluster in order to set the
                                                  idle job detection.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end" color="rgb(56 , 111 , 218)">4. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block id="unique_28_Connect_42_v5361099" chfox:nd-id="v5361099"><fo:inline id="unique_28_Connect_42_v5361100" chfox:nd-id="v5361100">Select
                                                  <fo:inline font-weight="700">Enable
                                                  Idle Job Detection</fo:inline> checkbox to search for
                                                  idle jobs in the cluster.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end" color="rgb(56 , 111 , 218)">5. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block id="unique_28_Connect_42_v5361102" chfox:nd-id="v5361102"><fo:block-container><fo:block start-indent="0" end-indent="0"><fo:inline id="unique_28_Connect_42_v5361103" chfox:nd-id="v5361103">Set
                                                  values for the following fields:</fo:inline>
                                                <fo:block id="unique_28_Connect_42_v5361104" chfox:nd-id="v5361104">
                                                  <fo:block-container space-before="1em" id="unique_28_Connect_42_v5361105" chfox:nd-id="v5361105"><fo:block end-indent="0" start-indent="0">
                                                  <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="0em" space-before="0em" id="unique_28_Connect_42_v5361106" chfox:nd-id="v5361106">
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end" color="rgb(56 , 111 , 218)">◦ </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block id="unique_28_Connect_42_v5361107" chfox:nd-id="v5361107"><fo:block-container><fo:block start-indent="0" end-indent="0"><fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" id="unique_28_Connect_42_v5361108" chfox:nd-id="v5361108"><fo:block end-indent="0" start-indent="0">
                                                  <fo:inline font-weight="700">Email
