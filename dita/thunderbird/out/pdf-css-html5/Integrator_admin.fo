                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_23__unique_23_Connect_42_i740881__entry__3"><fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" space-after.conditionality="retain" space-before.conditionality="retain"><fo:block end-indent="0" start-indent="0">Warning</fo:block></fo:block-container>
                                                  </fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_23__unique_23_Connect_42_i740881__entry__4"><fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" space-after.conditionality="retain" space-before.conditionality="retain"><fo:block end-indent="0" start-indent="0">Drive
                                                  is ready</fo:block></fo:block-container>
                                                  </fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_23__unique_23_Connect_42_i740881__entry__5"><fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" space-after.conditionality="retain" space-before.conditionality="retain"><fo:block end-indent="0" start-indent="0">Minor</fo:block></fo:block-container>
                                                  </fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" id="unique_23__unique_23_Connect_42_i740881__entry__6"><fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" space-after.conditionality="retain" space-before.conditionality="retain"><fo:block end-indent="0" start-indent="0">Drive
                                                  is rebuilding</fo:block></fo:block-container>
                                                  </fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  </fo:table-header><fo:table-body display-align="center">
                                                  <fo:table-row display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" space-after.conditionality="retain" space-before.conditionality="retain"><fo:block end-indent="0" start-indent="0">Major</fo:block></fo:block-container>
                                                  </fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" space-after.conditionality="retain" space-before.conditionality="retain"><fo:block end-indent="0" start-indent="0">Drive
                                                  has failed</fo:block></fo:block-container>
                                                  </fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  </fo:table-body></fo:table></fo:table-and-caption>
                                            </fo:block>
                                        </fo:block></fo:block-container>
                                        <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">
                                            <fo:block>
                                                <fo:table-and-caption border-collapse="collapse" space-before="1em" space-after="1em"><fo:table-caption start-indent="0" end-indent="0" keep-with-next="always"><fo:block-container page-break-after="avoid" font-weight="bold" space-before="0.5em" text-align="center"><fo:block end-indent="0" start-indent="0"/></fo:block-container></fo:table-caption><fo:table relative-align="baseline" chfox:html-table-width-policy="yes" table-layout="auto" border-bottom-color="black" border-bottom-style="solid" border-bottom-width="1px" border-left-color="black" border-left-style="solid" border-left-width="1px" margin-left="0" border-right-color="black" border-right-style="solid" border-right-width="1px" margin-right="0" border-top-color="black" border-top-style="solid" border-top-width="1px" hyphenate="true" space-before="0" space-after="0"><fo:table-column column-width="20%"/><fo:table-column column-width="80%"/><fo:table-header font-weight="bold" text-align="center" display-align="center">
                                                  <fo:table-row display-align="center">
