                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Table of
                                            dimensions you can run reports from.</fo:block></fo:block-container>
                                        <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">
                                                <fo:block>
