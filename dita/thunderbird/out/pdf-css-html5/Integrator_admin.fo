                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" space-after.conditionality="retain" space-before.conditionality="retain"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;clusterid&gt;</fo:inline></fo:block></fo:block-container>
