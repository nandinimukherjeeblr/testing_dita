                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" space-after.conditionality="retain" space-before.conditionality="retain"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-family="monospace" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">&lt;cluster_master&gt;</fo:inline></fo:block></fo:block-container>
                                                  </fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" space-after.conditionality="retain" space-before.conditionality="retain"><fo:block end-indent="0" start-indent="0">The
                                                  name of the master host for the cluster.</fo:block></fo:block-container>
                                                  </fo:block></fo:table-cell>
                                                  </fo:table-row>
                                                  <fo:table-row border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" display-align="center">
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" space-after.conditionality="retain" space-before.conditionality="retain"><fo:block end-indent="0" start-indent="0">Cluster version</fo:block></fo:block-container>
                                                  </fo:block></fo:table-cell>
