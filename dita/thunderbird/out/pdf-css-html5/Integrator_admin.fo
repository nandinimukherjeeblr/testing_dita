                            <fo:block role="Sect" id="unique_20" chfox:nd-id="v34589345">
                                <fo:block-container page-break-after="avoid" color="rgb(7 , 55 , 99)" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title19"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d472e4045"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d472e4048"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d472e4052"/><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d472e4056"/><fo:inline>Setting timeout and wait
                                    times</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Control job
                                        forwarding times.</fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">By default,
                                            timeout and wait time are set to 360 and 10
                                            respectively, but can be changed to suit each individual
                                            job-forwarding queue.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block role="Sect">
                                        <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_20_Connect_42_steps_hiu_nnr_yd" chfox:nd-id="steps_hiu_nnr_yd">
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end" color="rgb(56 , 111 , 218)">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                                <fo:inline>For the job-forwarding queue
                                                  define <fo:inline font-weight="700">MAX_RSCHED_TIME</fo:inline> in <fo:inline color="rgb(199 , 37 , 78)" font-family="monospace">host.queues</fo:inline>.</fo:inline>
                                                <fo:block>
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0"><fo:inline font-weight="700">MAX_RSCHED_TIME</fo:inline>=<fo:inline font-style="italic">timeout</fo:inline><fo:inline font-style="italic"/>
                                                  [<fo:inline font-style="italic">wait_time</fo:inline>]</fo:block></fo:block-container>
                                                </fo:block>
                                            </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end" color="rgb(56 , 111 , 218)">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Run <fo:inline color="rgb(128 , 0 , 0)">badmin reconfig</fo:inline> for the changes to take
                                                  effect.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                        </fo:list-block>
                                    </fo:block>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Jobs submitted
                                            to queue pend in an execution cluster for up to the
                                            specified number of timeout seconds before returning to
                                            the submission cluster for rescheduling. Jobs can be
                                            forwarded to the same cluster once again after wait
                                            time, in seconds.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">
                                            <fo:block-container background-color="rgb(238 , 238 , 238)" font-family="monospace" font-size="0.8em" space-after="0.5em" margin-left="0.5em" margin-right="0" space-before="0.5em" max-height="600px" chfox:overflow-wrap="break-word" break-line-at-hyphens="avoid" role="Code" padding-bottom="2px" padding-left="4px" padding-right="4px" padding-top="2px" linefeed-treatment="preserve" white-space-collapse="false" white-space-treatment="preserve" wrap-option="wrap"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container background-color="rgb(238 , 238 , 238)" font-size="0.8em" padding-bottom="0" padding-left="0" margin-left="0" padding-right="0" margin-right="0" padding-top="0"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">Begin Queue</fo:inline><fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">QUEUE_NAME=Q1</fo:inline><fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">PRIORITY=40</fo:inline><fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">NICE=10</fo:inline><fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">SNDJOBS_TO=cluster_e2+1 cluster_e3</fo:inline><fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">MAX_RSCHED_TIME=50 10</fo:inline><fo:inline background-color="rgb(238 , 238 , 238)" color="rgb(128 , 0 , 0)" font-size="0.8em" role="Code" padding-bottom="2px" padding-left="0" padding-right="0" padding-top="2px">END QUEUE</fo:inline></fo:block></fo:block-container></fo:block></fo:block></fo:block-container>
                                        </fo:block></fo:block-container>
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">and in <fo:inline color="rgb(199 , 37 , 78)" font-family="monospace">host.params</fo:inline>, <fo:inline font-family="monospace" font-size="smaller">MBD_SLEEP_TIME=20</fo:inline></fo:block></fo:block-container>
                                        <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">Thus the cluster reselection
                                            timeout and wait time are given by:<fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_20_Connect_42_ul_tht_eor_yd" chfox:nd-id="ul_tht_eor_yd">
                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end" color="rgb(56 , 111 , 218)">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0"><fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">timeout
                                                  = 50x20 seconds = 1000 seconds</fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end" color="rgb(56 , 111 , 218)">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0"><fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">wait
                                                  time = 10x20 seconds = 200 seconds</fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                            </fo:list-block></fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block>
                            <fo:block role="Sect" id="unique_21" chfox:nd-id="i740750">
                                <fo:block-container page-break-after="avoid" color="rgb(7 , 55 , 99)" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title20"><fo:block end-indent="0" start-indent="0"><fo:inline background-color="transparent" color="transparent" font-size="0px" max-width="2px" vertical-align="super" id="d472e4178"/><fo:inline>Logical drive strength</fo:inline></fo:block></fo:block-container>
                                
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0">Provides a
                                        notification on the optimal health of logical drives.</fo:block></fo:block-container>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_21_Connect_42_i740738" chfox:nd-id="i740738"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">Logical drive strength
