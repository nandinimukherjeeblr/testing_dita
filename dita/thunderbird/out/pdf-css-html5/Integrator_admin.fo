                                            header</fo:block></fo:block-container>
                                        <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">The UDP header options are:<fo:block>
                                                <fo:table-and-caption border-collapse="collapse" space-before="1em" space-after="1em"><fo:table-caption start-indent="0" end-indent="0" keep-with-next="always"><fo:block-container page-break-after="avoid" font-weight="bold" space-before="0.5em" text-align="center"><fo:block end-indent="0" start-indent="0"/></fo:block-container></fo:table-caption><fo:table relative-align="baseline" chfox:html-table-width-policy="yes" table-layout="auto" border-bottom-color="black" border-bottom-style="solid" border-bottom-width="1px" border-left-color="black" border-left-width="2pt" border-left-style="none" border-right-color="black" border-right-width="2pt" border-right-style="none" border-top-color="black" border-top-style="solid" border-top-width="1px" hyphenate="true" space-before="0" space-after="0"><fo:table-column column-width="15%"/><fo:table-column column-width="85%"/><fo:table-header font-weight="bold" text-align="center" display-align="center">
