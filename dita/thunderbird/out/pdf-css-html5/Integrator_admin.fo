                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end" color="rgb(56 , 111 , 218)">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0"><fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Notify
